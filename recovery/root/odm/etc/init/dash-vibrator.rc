# Haptics
service vibratorfeature-hal-service /odm/bin/hw/vendor.xiaomi.hardware.vibratorfeature.service
    class hal
    user root
    group root input audio
    interface aidl android.hardware.vibrator.IVibrator/vibratorfeature
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /odm/lib64:/vendor/lib64:/system/lib64
    disabled

# SPDX-License-Identifier: Apache-2.0
# Hardware
on init
    setprop sys.usb.controller 16701000.usb0
    # CPU low-power initialization.
    insmod /lib/modules/sspm_v3.ko
    insmod /lib/modules/mcupm.ko
    insmod /lib/modules/mtk-lpm.ko
    insmod /lib/modules/mtk-lpm-dbg-common-v2.ko
    insmod /lib/modules/mtk-lpm-plat-v2.ko
    # Touch
    write /sys/module/firmware_class/parameters/path /odm/firmware
    insmod /lib/modules/xiaomi_touch_dash.ko
    insmod /lib/modules/nt38771_touch_dash.ko
    # Haptics
    insmod /lib/modules/fs3002_haptic.ko

on boot
    start mtk.plpath.utils.link
    # Haptics
    start vibratorfeature-hal-service
    # Touch
    wait /dev/xiaomi-touch 10
    start mt6991-touch-report
